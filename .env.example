# Manager Library — API environment variables
# Copy to .env and fill in the values. Never commit .env.
#
# Variables defined in plan.md §2. APP_KEY is added because Laravel requires it
# for encryption; generate it with: php artisan key:generate --show

# Laravel application key (required for encryption)
APP_KEY=

# PostgreSQL connection parsed via parse_url() in config/database.php
DATABASE_URL=postgresql://library:library@db:5432/library

# JWT — generate with: php artisan jwt:secret
JWT_SECRET=

# Initial admin account seeded at first boot (T-17)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Local path inside the container where book covers are stored
COVERS_DIR=storage/app/public/covers

# Allowed CORS origin for the frontend
CORS_ORIGIN=http://localhost:5173
